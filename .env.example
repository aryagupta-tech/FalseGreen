# FalseGreen environment.
# Local development defaults. See docs/deployment.md for production.
# Copy this file to .env.local and fill in only what you need.
# Never commit real credentials. Only publicConfig is sent to the browser.

# --- Runtime ---------------------------------------------------------------

# Set by the runtime. The session cookie becomes secure only when
# NODE_ENV=production. Leave this commented for local development.
# NODE_ENV=production

# VERCEL is injected by the platform. Do not set it locally: it changes the
# execution and job driver defaults.
# VERCEL=1

# --- Execution -------------------------------------------------------------

# local | sandbox
# Default: local, or sandbox when VERCEL is set.
EXECUTION_DRIVER=local

# Required when EXECUTION_DRIVER=sandbox. Build it with
# scripts/build-sandbox-snapshot.mjs.
VERCEL_SANDBOX_SNAPSHOT_ID=

# Read into config but not consumed by the sandbox runner. The snapshot fixes
# the runtime. The provisioning script reads FG_SANDBOX_RUNTIME.
VERCEL_SANDBOX_RUNTIME=node24

# Set to 1 to keep the local runner's throwaway directory after a run.
# Leave unset or 0 in normal use.
FG_KEEP_LOCAL_ARTIFACTS=0

# --- Store -----------------------------------------------------------------

# file | redis
# Default: redis when both Upstash values are set, otherwise file.
STORE_DRIVER=file

# Upstash Redis REST credentials. Use the HTTPS REST URL, not a TCP URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Directory for the file store.
# Default: os.tmpdir()/falsegreen-data
FG_DATA_DIR=

# --- Model (repair only) ---------------------------------------------------

# auto | openai-compatible | ollama | unconfigured
# auto resolves to openai-compatible when MODEL_API_BASE_URL and MODEL_ID are
# set, and to unconfigured otherwise. ollama is an alias for openai-compatible
# with a default base URL of http://127.0.0.1:11434/v1; MODEL_ID is still
# required.
MODEL_DRIVER=auto

# OpenAI-compatible base URL, with or without a trailing /v1.
# Example: https://your-model-endpoint.example/v1
MODEL_API_BASE_URL=

# Bearer token for the model endpoint. Keep this server-side only.
MODEL_API_KEY=

# Model name sent in the chat-completions request.
MODEL_ID=

# Model request timeout and output cap.
MODEL_TIMEOUT_MS=45000
MODEL_MAX_TOKENS=900

# --- Job driver ------------------------------------------------------------

# inline | vercel-workflow
# Default: inline, or vercel-workflow when VERCEL is set.
# vercel-workflow makes every engine tick a durable Workflow SDK step. If the
# workflow cannot start, the same driver runs inline as a fallback.
JOB_DRIVER=inline

# --- Limits ----------------------------------------------------------------

FG_MAX_MUTATIONS=12
FG_MAX_ACTIVE_JOBS=2
FG_MAX_MODEL_ATTEMPTS=2
FG_TEST_TIMEOUT_MS=10000
FG_SCAN_DEADLINE_MS=180000
FG_REPAIR_DEADLINE_MS=120000
FG_RUN_TTL_MS=86400000
FG_MAX_RUNS_PER_SESSION_PER_HOUR=20

# These limits are fixed in src/core/config.js and cannot be set through env:
# source 65536 bytes, tests 65536 bytes, requirement 4096 bytes,
# proposed args 4096 bytes, captured output 65536 bytes, UI poll 700 ms.

# --- Sandbox snapshot provisioning ----------------------------------------

# Read by scripts/build-sandbox-snapshot.mjs only.
# Prefer VERCEL_OIDC_TOKEN, for example from `vercel env pull .env.local`.
VERCEL_OIDC_TOKEN=
# Or set this token together with the team and project ids.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Provisioning overrides.
FG_SANDBOX_RUNTIME=node24
FG_VITEST_VERSION=5.0.5

# --- CLI -------------------------------------------------------------------

# CLI base URL when --url is omitted. The entrypoint is bin/falsegreen.js.
FALSEGREEN_URL=http://localhost:3000
